{
  // Configurația Worker-ului care găzduieşte site-ul.
  // Numele trebuie să rămână acelaşi cu al Worker-ului din Cloudflare,
  // altfel următorul build ar crea unul nou, la altă adresă.
  "name": "hudas-jewelry",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // Worker-ul stă în contul Cloudflare al Hudei, lângă domeniu: Cloudflare
  // nu lasă un domeniu dintr-un cont să arate spre un Worker din altul.
  "account_id": "77fe04201b2b97e2e7af9be776e3ab59",
  // Site-ul se vede doar pe domeniu; adresa workers.dev e oprită.
  "workers_dev": false,
  // Domeniul de bază e hudasjewelry.com. Celelalte trei gazde — www. şi
  // domeniul vechi, scris greşit — ajung tot la Worker, doar ca să fie
  // redirecţionate de acolo (vezi CANONICAL în worker.js).
  "routes": [
    { "pattern": "hudasjewelry.com", "custom_domain": true },
    { "pattern": "www.hudasjewelry.com", "custom_domain": true },
    { "pattern": "hudasjewlery.com", "custom_domain": true },
    { "pattern": "www.hudasjewlery.com", "custom_domain": true }
  ],
  "assets": {
    // Fişierele site-ului stau în rădăcina repo-ului.
    "directory": "./",
    "binding": "ASSETS",
    // Orice adresă inexistentă primeşte 404.html, cu statusul 404.
    "not_found_handling": "404-page",
    // Fişierele statice se servesc de obicei direct, fără să pornească
    // Worker-ul — deci nici redirecţionarea de gazdă/https din worker.js
    // n-ar apuca să ruleze. Îl pornim primul peste tot în afară de /assets/:
    // o invocare pe pagină vizitată, nu una pe fiecare poză. Lista nu poate
    // enumera doar paginile: cu not_found_handling, o adresă inexistentă
    // deschisă în browser ar primi 404.html fără să treacă prin Worker, deci
    // n-ar mai fi redirecţionată de pe http:// sau de pe domeniul vechi.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Câte parole greşite pot veni de pe o adresă IP într-un minut: vezi
  // server/limit.js. Cere wrangler 4.36 sau mai nou. namespace_id e un număr
  // ales de noi, unic în cont; nu trebuie creat nimic în dashboard. period
  // poate fi doar 10 sau 60 (secunde).
  "ratelimits": [
    {
      "name": "PASSWORD_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
