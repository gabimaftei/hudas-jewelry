# Ce nu trebuie servit ca fişier al site-ului: codul serverului,
# configurările şi documentaţia. Nimic secret — repo-ul e public —
# dar n-au ce căuta pe domeniul public.
worker.js
wrangler.jsonc
server/
data/
.claude/
*.md
tools/
# Fişiere locale sau temporare: wrangler îşi scrie build-ul în .wrangler/
# chiar în folderul publicat, iar .dev.vars are parolele de test.
.wrangler/
.dev.vars
node_modules/
.git/
.gitignore
